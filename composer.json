{
    "name": "attributes-php/validation-ext",
    "type": "library",
    "description": "Pydantic-inspired PHP library for validating data via type hints at lightning speed ⚡️",
    "keywords": [
        "validation",
        "fast",
        "attributes"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "autoload-dev": {
        "psr-4": {
            "Attributes\\Validation\\Tests\\": "tests/php/tests"
        }
    },
    "require-dev": {
        "laravel/pint": "1.30",
        "pestphp/pest": "^3.0"
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
